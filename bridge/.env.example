# Copy to .env.local (gitignored) and fill in. Never commit secrets.
# Generate: openssl rand -base64 32   OR   python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
DEAL_QUILL_BRIDGE_TOKEN=replace-me-with-a-long-random-string

# Optional — enable real AI (pick one path):
# XAI_API_KEY=
# GROK_API_KEY=
# GROK_MCP_URL=http://127.0.0.1:9xxx/mcp

# Optional:
# PORT=8787
# XAI_MODEL=grok-2-latest
# XAI_API_URL=https://api.x.ai/v1/chat/completions
